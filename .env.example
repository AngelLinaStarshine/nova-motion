# Studio website deploy (e.g. novamotion.ca)
# Point "Shop" nav links to the shop custom domain.
VITE_SHOP_URL=https://shop.novamotion.ca

# Shop app deploy (e.g. shop.novamotion.ca)
# Point "Studio" nav link back to the main site.
VITE_STUDIO_URL=https://novamotion.ca

# Local dev (optional — run studio on 5173, shop on 5174):
# VITE_SHOP_URL=http://localhost:5174
# VITE_STUDIO_URL=http://localhost:5173
